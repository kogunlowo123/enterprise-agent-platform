# Copy to .env for local development. Never commit the result.
#
# Settings are validated at startup and the process refuses to start if the combination is
# unsafe for the environment. Every value below is optional for local: with none of them
# set the platform runs offline against the deterministic provider and an in-memory store.

# ---------------------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------------------
EAP_ENVIRONMENT=local                       # local | dev | staging | prod
EAP_SERVICE_VERSION=0.1.0

# ---------------------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------------------
EAP_IDENTITY_ISSUER=https://issuer.local/eap
EAP_IDENTITY_AUDIENCE=eap-gateway

# Production: verify RS256/ES256 against the identity provider's published keys.
# EAP_IDENTITY_JWKS_URL=https://login.example.com/.well-known/jwks.json

# Local only: HS256 signing for `eap dev-token`. Startup fails if this is set in
# staging or prod. Use at least 32 bytes.
EAP_IDENTITY_DEV_SIGNING_KEY=change-me-a-local-development-key-at-least-32-bytes

EAP_IDENTITY_CLOCK_SKEW_SECONDS=60
EAP_IDENTITY_JWKS_CACHE_SECONDS=600

# ---------------------------------------------------------------------------------------
# SecOps
# ---------------------------------------------------------------------------------------
EAP_SECOPS_BLOCK_ON_INJECTION=true          # false runs shadow mode; refused in prod
EAP_SECOPS_INJECTION_THRESHOLD=0.5
EAP_SECOPS_REDACT_PII_IN_PROMPTS=true
EAP_SECOPS_AUDIT_SINK=memory                # memory | file; memory is refused in prod
EAP_SECOPS_AUDIT_FILE_PATH=./var/audit/audit.jsonl

# ---------------------------------------------------------------------------------------
# NetOps
# ---------------------------------------------------------------------------------------
EAP_NETOPS_RATE_LIMIT_PER_MINUTE=120
EAP_NETOPS_RATE_LIMIT_BURST=30
EAP_NETOPS_REQUEST_TIMEOUT_SECONDS=60
EAP_NETOPS_PROVIDER_TIMEOUT_SECONDS=45
EAP_NETOPS_MAX_RETRIES=2
EAP_NETOPS_CIRCUIT_FAILURE_THRESHOLD=5
EAP_NETOPS_CIRCUIT_RESET_SECONDS=30

# ---------------------------------------------------------------------------------------
# DataOps
# ---------------------------------------------------------------------------------------
EAP_DATAOPS_VECTOR_STORE=memory             # memory | pgvector; memory refused in prod
# EAP_DATAOPS_POSTGRES_DSN=postgresql://eap:eap@localhost:5432/eap
EAP_DATAOPS_EMBEDDING_PROVIDER=deterministic   # deterministic | openai
EAP_DATAOPS_EMBEDDING_MODEL=text-embedding-3-small
EAP_DATAOPS_EMBEDDING_DIMENSIONS=256
EAP_DATAOPS_CHUNK_MAX_TOKENS=512
EAP_DATAOPS_CHUNK_OVERLAP_TOKENS=64
EAP_DATAOPS_RETRIEVAL_TOP_K=8

# Fine-grained PAT with `Contents: read` on the repositories you intend to ingest.
# Public repositories need no token at all.
# EAP_DATAOPS_GITHUB_TOKEN=
EAP_DATAOPS_GITHUB_API_URL=https://api.github.com
# GitHub Enterprise Server: https://github.your-company.internal/api/v3

# ---------------------------------------------------------------------------------------
# LLMOps
# ---------------------------------------------------------------------------------------
# With neither key set the platform serves the deterministic provider.
# EAP_LLMOPS_ANTHROPIC_API_KEY=
# EAP_LLMOPS_OPENAI_API_KEY=
EAP_LLMOPS_DEFAULT_ROUTE=balanced
EAP_LLMOPS_DAILY_TENANT_BUDGET_USD=25
EAP_LLMOPS_MAX_OUTPUT_TOKENS=2048

# ---------------------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------------------
EAP_OBS_SERVICE_NAME=enterprise-agent-platform
EAP_OBS_LOG_LEVEL=INFO
EAP_OBS_LOG_FORMAT=console                  # console for local, json everywhere else
# EAP_OBS_OTLP_ENDPOINT=http://localhost:4318/v1/traces
EAP_OBS_TRACE_SAMPLE_RATIO=1.0

# Off by default and refused in production: prompt bodies routinely carry customer data,
# and a trace backend is rarely inside the same compliance boundary as the datastore.
EAP_OBS_CAPTURE_PROMPT_CONTENT=false
